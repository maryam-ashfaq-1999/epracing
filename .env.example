# Firebase web app config (from Firebase console > Project settings > Your apps).
# This is not secret - Firebase's security boundary is Firestore rules, not
# hiding these values. Copy this file to .env.local and fill in real values
# for local dev; the deploy workflow injects the same names from repo secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
